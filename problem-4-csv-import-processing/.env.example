# API server
PORT=4003

# PostgreSQL
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=csv_import_db
PG_POOL_MAX=10

# Redis (required by BullMQ - the queue that connects the API process
# to the worker process)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Upload limits
MAX_FILE_SIZE_BYTES=2684354560
UPLOAD_DIR=./storage/uploads
ERRORS_DIR=./storage/errors

# Processing
BATCH_SIZE=1000
WORKER_CONCURRENCY=1

# Stability under concurrent uploads
MAX_CONCURRENT_UPLOADS=3
