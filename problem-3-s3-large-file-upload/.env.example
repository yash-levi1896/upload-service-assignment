# Server
PORT=4002

# PostgreSQL
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=s3_upload_db
PG_POOL_MAX=10

# AWS
# Leave AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY empty to fall back to the
# default credential provider chain (recommended outside local dev: an IAM
# role, shared credentials file, etc.)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=your-bucket-name

# Multipart tuning (S3 hard limits: part >= 5MB except the last part,
# <= 10,000 parts per upload, object <= 5TB total)
DEFAULT_PART_SIZE_BYTES=10485760
MAX_FILE_SIZE_BYTES=5368709120

# Comma separated whitelist. Leave empty to allow everything (not recommended in prod).
ALLOWED_MIME_TYPES=video/mp4,application/zip,application/pdf,image/png,image/jpeg
ALLOWED_EXTENSIONS=.mp4,.zip,.pdf,.png,.jpg,.jpeg

# Pre-signed URL lifetimes
PRESIGNED_PART_URL_EXPIRY_SECONDS=900
PRESIGNED_DOWNLOAD_URL_EXPIRY_SECONDS=3600

# How long an initiated-but-never-completed upload is kept before it's
# eligible for expiry (see npm run cleanup:expired)
UPLOAD_TTL_HOURS=24
