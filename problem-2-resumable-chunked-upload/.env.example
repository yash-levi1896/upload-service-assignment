# Server
PORT=4001

# PostgreSQL
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=chunked_upload_db
PG_POOL_MAX=10

# Chunking
DEFAULT_CHUNK_SIZE_BYTES=10485760
MAX_FILE_SIZE_BYTES=5368709120
CHUNKS_DIR=./storage/chunks
COMPLETED_DIR=./storage/completed

ALLOWED_MIME_TYPES=video/mp4,application/zip,application/pdf,image/png,image/jpeg
ALLOWED_EXTENSIONS=.mp4,.zip,.pdf,.png,.jpg,.jpeg

# Stability under concurrent chunk uploads
MAX_CONCURRENT_CHUNK_UPLOADS=20

# How long an initiated-but-abandoned upload session is kept before it's
# eligible for cleanup (used by the optional cleanup script)
STALE_UPLOAD_HOURS=24
