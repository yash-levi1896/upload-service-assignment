# Server
PORT=4000

# PostgreSQL
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=file_upload_db
PG_POOL_MAX=10

# Upload limits
MAX_FILE_SIZE_BYTES=5368709120
UPLOAD_DIR=./storage/uploads

# Comma separated whitelist. Leave empty to allow everything (not recommended in prod).
ALLOWED_MIME_TYPES=video/mp4,application/zip,application/pdf,image/png,image/jpeg
ALLOWED_EXTENSIONS=.mp4,.zip,.pdf,.png,.jpg,.jpeg

# Stability under concurrent load
MAX_CONCURRENT_UPLOADS=5
